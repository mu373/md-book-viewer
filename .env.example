# Algolia Search Configuration
# Get these from https://dashboard.algolia.com/
# Copy this file to .env and fill in your credentials

# Server-side only (for indexing) - DO NOT expose to client
ALGOLIA_APP_ID=your_app_id
ALGOLIA_ADMIN_KEY=your_admin_key
ALGOLIA_INDEX_NAME=md-book-viewer

# Client-side (for search) - safe to expose
NEXT_PUBLIC_ALGOLIA_APP_ID=your_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_search_only_key
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=md-book-viewer
